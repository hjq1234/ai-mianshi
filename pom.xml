<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/> <!-- lookup parent from repository -->
  </parent>
  <groupId>com.ke.nhservice</groupId>
  <artifactId>ai-mianshi</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>ai-mianshi</name>
  <description>ai-mianshi</description>
  <url/>
  <licenses>
    <license/>
  </licenses>
  <developers>
    <developer/>
  </developers>
  <scm>
    <connection/>
    <developerConnection/>
    <tag/>
    <url/>
  </scm>
  <properties>
    <java.version>21</java.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.4</version>
    </dependency>

    <!-- sherpa-onnx：本地语音识别（答题区录音转文字）。
         这两个 jar 不在 Maven 中央仓库，得先下载再 mvn install:install-file 装进本地仓库
         （命令见 README 的「语音答题」一节）。换台机器 / 清了本地仓库就要重做一次。
         groupId 刻意用 JitPack 那套 com.github.k2-fsa.sherpa.onnx，不是项目自己的
         com.k2fsa.sherpa.onnx —— 将来若改成 pom 里加 repository 直拉，这里一个字不用动。
         注意版本字面量里的 v 是必须的（v1.13.8），和 install-file 的 -Dversion 必须一模一样 -->
    <dependency>
      <groupId>com.github.k2-fsa.sherpa.onnx</groupId>
      <artifactId>sherpa-onnx-jvm</artifactId>
      <version>v1.13.8</version>
    </dependency>
    <!-- 这个 jar 里内嵌着 sherpa-onnx/native/win-x64/ 下的 onnxruntime.dll 和
         sherpa-onnx-jni.dll，运行时 LibraryLoader 自己解压加载，
         所以**不需要**配 java.library.path。
         换平台就换这一条的 artifactId（linux-x64 / osx-aarch64 / win-arm64 都有） -->
    <dependency>
      <groupId>com.github.k2-fsa.sherpa.onnx</groupId>
      <artifactId>sherpa-onnx-native-lib-win-x64</artifactId>
      <version>v1.13.8</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
